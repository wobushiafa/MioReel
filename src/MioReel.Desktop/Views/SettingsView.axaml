<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aviora="https://github.com/wobushiafa/Aviora"
             xmlns:models="using:MioReel.Core.Models"
             xmlns:vm="using:MioReel.Desktop.ViewModels"
             x:Class="MioReel.Desktop.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <TextBlock Grid.Row="0" Text="设置" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,18">
      <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

    <!-- Appearance -->
    <aviora:AvioraCard Background="{DynamicResource SurfaceBrush}"
                       BorderBrush="{DynamicResource BorderSubtleBrush}"
                       BorderThickness="1"
                       CornerRadius="18"
                       Padding="18">
      <StackPanel Spacing="14">
        <TextBlock Text="外观与界面" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="主题模式" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="暗色影院模式在夜间观影更护眼" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="pill-btn"
                    Classes.active="{Binding IsDarkTheme}"
                    Content="深色影院"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:True}" />
            <Button Classes="pill-btn"
                    Classes.active="{Binding !IsDarkTheme}"
                    Content="浅色日间"
                    Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:False}" />
          </StackPanel>
        </Grid>

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="小窗看剧窗口置顶" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="切换到小窗模式时自动保持在桌面最前端" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.Name="小窗看剧窗口置顶"
                        IsChecked="{Binding MiniAlwaysOnTop, Mode=TwoWay}"
                        OnContent="开"
                        OffContent="关" />
        </Grid>
      </StackPanel>
    </aviora:AvioraCard>

    <!-- Account & Cloud Sync -->
    <aviora:AvioraCard Background="{DynamicResource SurfaceBrush}"
                       BorderBrush="{DynamicResource BorderSubtleBrush}"
                       BorderThickness="1"
                       CornerRadius="18"
                       Padding="18">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="账号与云同步" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding AccountStatusText}" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="brand-cta" Content="登录 / 注册" IsVisible="{Binding IsSignedOut}" Command="{Binding OpenLoginCommand}" />
            <Button Classes="surface-btn" Content="退出登录" IsVisible="{Binding IsSignedIn}" Command="{Binding SignOutCommand}" />
            <Button Classes="surface-btn" Content="立即同步" IsVisible="{Binding IsSignedIn}" Command="{Binding SyncNowCommand}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="登录后观看历史会自动上传到云端，在任意电脑用同一账号登录即可继续观看；未登录时历史仅保存在本机。"
                   FontSize="{DynamicResource AppMinFontSize}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <StackPanel Spacing="8">
          <TextBlock Text="账号服务地址" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBox AutomationProperties.Name="账号服务地址"
                   Text="{Binding AccountApiBaseUrl, Mode=TwoWay}"
                   PlaceholderText="https://account.example.com"
                   CornerRadius="10" Height="36" VerticalContentAlignment="Center" />
          <TextBlock Text="填写你部署的账号服务根地址（IIS 站点地址），修改后自动保存。"
                     FontSize="{DynamicResource AppMinFontSize}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </StackPanel>
    </aviora:AvioraCard>

    <!-- Playback -->
    <aviora:AvioraCard Background="{DynamicResource SurfaceBrush}"
                       BorderBrush="{DynamicResource BorderSubtleBrush}"
                       BorderThickness="1"
                       CornerRadius="18"
                       Padding="18">
      <StackPanel Spacing="14">
        <TextBlock Text="播放偏好" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="默认清晰度" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="优先选择的播放画质（网络波动时自动平滑降级）" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="pill-btn" Classes.active="{Binding IsQuality1080}" Content="1080P" Command="{Binding SetDefaultQualityCommand}" CommandParameter="1080" />
            <Button Classes="pill-btn" Classes.active="{Binding IsQuality720}" Content="720P" Command="{Binding SetDefaultQualityCommand}" CommandParameter="720" />
            <Button Classes="pill-btn" Classes.active="{Binding IsQuality480}" Content="480P" Command="{Binding SetDefaultQualityCommand}" CommandParameter="480" />
          </StackPanel>
        </Grid>

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="视频渲染方式" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="GPU 纹理支持叠加控件；NativeSurface 采用独立硬件表面，控制栏自动外置到底部" FontSize="{DynamicResource AppMinFontSize}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="pill-btn" Classes.active="{Binding IsRenderAuto}" Content="自动" Command="{Binding SetRenderModeCommand}" CommandParameter="{x:Static models:VideoRenderMode.Auto}" />
            <Button Classes="pill-btn" Classes.active="{Binding IsRenderGpu}" Content="GPU 纹理" Command="{Binding SetRenderModeCommand}" CommandParameter="{x:Static models:VideoRenderMode.GpuComposition}" />
            <Button Classes="pill-btn" Classes.active="{Binding IsRenderSoftware}" Content="软件渲染" Command="{Binding SetRenderModeCommand}" CommandParameter="{x:Static models:VideoRenderMode.SoftwareBitmap}" />
            <Button Classes="pill-btn" Classes.active="{Binding IsRenderNative}" Content="NativeSurface" Command="{Binding SetRenderModeCommand}" CommandParameter="{x:Static models:VideoRenderMode.NativeSurface}" />
          </StackPanel>
        </Grid>

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="单集播完自动连播下一集" VerticalAlignment="Center" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.Name="单集播完自动连播下一集"
                        IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"
                        OnContent="开"
                        OffContent="关" />
        </Grid>

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="播放时显示弹幕" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="从视频源拉取分集实时弹幕并在画面上方飘动" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.Name="播放时显示弹幕"
                        IsChecked="{Binding Player.IsDanmakuEnabled, Mode=TwoWay}"
                        OnContent="开"
                        OffContent="关" />
        </Grid>

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="应用内音量" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="仅调节客户端播放音量，不改动系统音量" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="pill-btn"
                    Classes.active="{Binding Player.IsEffectivelyMuted}"
                    Padding="10,5"
                    Content="{Binding Player.VolumeLabel}"
                    Command="{Binding Player.ToggleMuteCommand}" />
            <Slider Classes="player-seek"
                    Width="150"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding Player.VolumePercent, Mode=TwoWay}"
                    VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="音量增强" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="放大低音量片源的音频增益（最高 +18 dB），切换后立即作用于当前播放" FontSize="{DynamicResource AppMinFontSize}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="pill-btn" Classes.active="{Binding Player.IsAudioBoostOff}" Content="关闭" Command="{Binding Player.SetAudioBoostCommand}" CommandParameter="0" />
            <Button Classes="pill-btn" Classes.active="{Binding Player.IsAudioBoost6}" Content="+6 dB" Command="{Binding Player.SetAudioBoostCommand}" CommandParameter="6" />
            <Button Classes="pill-btn" Classes.active="{Binding Player.IsAudioBoost12}" Content="+12 dB" Command="{Binding Player.SetAudioBoostCommand}" CommandParameter="12" />
            <Button Classes="pill-btn" Classes.active="{Binding Player.IsAudioBoost18}" Content="+18 dB" Command="{Binding Player.SetAudioBoostCommand}" CommandParameter="18" />
          </StackPanel>
        </Grid>

      </StackPanel>
    </aviora:AvioraCard>

    <!-- Hotkeys & Global Boss Key -->
    <aviora:AvioraCard Background="{DynamicResource SurfaceBrush}"
                       BorderBrush="{DynamicResource BorderSubtleBrush}"
                       BorderThickness="1"
                       CornerRadius="18"
                       Padding="18">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="快捷键与全局热键" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding GlobalHotkeyStatusSummary}"
                       FontSize="{DynamicResource AppMinFontSize}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  AutomationProperties.Name="恢复默认快捷键"
                  Classes="surface-btn"
                  VerticalAlignment="Center"
                  Content="恢复默认"
                  Command="{Binding ResetHotkeysCommand}" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="启用系统全局热键" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="开启后即使窗体已隐藏或切换到其他应用，也可响应系统全局热键" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.Name="启用系统全局热键"
                        IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}"
                        OnContent="开"
                        OffContent="关" />
        </Grid>

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <ItemsControl ItemsSource="{Binding HotkeyRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HotkeyRowViewModel">
              <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="{DynamicResource AppMinFontSize}"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Border Background="{DynamicResource AccentSoftBrush}"
                              IsVisible="{Binding IsGlobal}"
                              CornerRadius="999"
                              Padding="7,1"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScopeBadge}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentRoseBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding StatusError}"
                               IsVisible="{Binding HasStatusError}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentRoseBrush}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="pill-btn"
                            Classes.active="{Binding IsRecording}"
                            MinWidth="126"
                            HorizontalContentAlignment="Center"
                            Content="{Binding ButtonText}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).BeginRecordHotkeyCommand}"
                            CommandParameter="{Binding Action}" />
                    <Button Classes="surface-btn"
                            Padding="8,5"
                            FontSize="11"
                            Content="清除"
                            IsVisible="{Binding CanClear}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ClearHotkeyCommand}"
                            CommandParameter="{Binding Action}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </aviora:AvioraCard>

    <!-- Storage & Service -->
    <aviora:AvioraCard Background="{DynamicResource SurfaceBrush}"
                       BorderBrush="{DynamicResource BorderSubtleBrush}"
                       BorderThickness="1"
                       CornerRadius="18"
                       Padding="18">
      <StackPanel Spacing="14">
        <TextBlock Text="存储与服务" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="离线下载目录" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding DownloadDirectory}" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Classes="surface-btn" Content="更改目录" Click="OnChooseDownloadDirectoryClick" />
        </Grid>
        <TextBlock Text="更改目录仅影响新任务，已有下载保留在原目录。" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />

        <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" />

        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="视频源服务地址" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Border Grid.Column="1"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="999"
                    Padding="8,2">
              <TextBlock Text="{Binding SourceStatusText}" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource AccentRoseBrush}" />
            </Border>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox AutomationProperties.Name="视频源服务地址"
                     Text="{Binding GatewayBaseUrl, Mode=TwoWay}"
                     PlaceholderText="https://miaomiaotv.diaofanle.com"
                     CornerRadius="10"
                     Height="36"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="brand-cta"
                    Content="连接并同步"
                    Command="{Binding TestGatewayCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox AutomationProperties.Name="访问令牌"
                     Text="{Binding GatewayToken, Mode=TwoWay}"
                     PlaceholderText="访问令牌（Bearer Token，服务端开启鉴权时必填）"
                     PasswordChar="{Binding TokenPasswordChar}"
                     CornerRadius="10"
                     Height="34"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="surface-btn"
                    MinWidth="68"
                    HorizontalContentAlignment="Center"
                    Content="{Binding TokenVisibilityButtonText}"
                    Command="{Binding ToggleTokenVisibilityCommand}" />
          </Grid>
          <TextBlock Text="若服务端已开启访问鉴权，请填写配置中的访问令牌后点击“连接并同步”，配置会自动保存在本地。"
                     FontSize="{DynamicResource AppMinFontSize}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </StackPanel>
    </aviora:AvioraCard>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
